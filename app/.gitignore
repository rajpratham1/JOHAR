# Flutter / Dart build + tooling artifacts
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies

# Generated localization .dart (produced by `flutter gen-l10n` / `flutter pub get`).
# The .arb source files in lib/l10n/ ARE tracked; only the generated Dart is ignored.
lib/l10n/app_localizations*.dart

# IDE
.idea/
*.iml
.vscode/

# Generated native platform folders.
# JOHAR intentionally does NOT commit these — the GitHub Actions workflow
# (.github/workflows/build-apk.yml) recreates them with `flutter create`
# on every build. This keeps the repo lean and platform files reproducible.
# If you later add custom native config (e.g. AR camera permissions), commit
# only the specific files you change and drop the matching ignore line here.
/android/
/ios/
/linux/
/macos/
/windows/
/web/
