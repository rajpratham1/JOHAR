rules_version = '2';

// JOHAR Storage rules. Training assets are readable by any signed-in user;
// only admins upload them, with size + type limits. Certificate PDFs are
// written server-side only.
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && request.auth.token.get('role', 'worker') == 'admin'; }

    // AR models, images, audio and video used by training modules.
    match /modules/{allPaths=**} {
      allow read:  if isSignedIn();
      allow write: if isAdmin()
                   && request.resource.size < 50 * 1024 * 1024   // 50 MB cap
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType.matches('video/.*')
                       || request.resource.contentType.matches('audio/.*')
                       || request.resource.contentType.matches('model/.*')
                       || request.resource.contentType == 'application/octet-stream'); // .glb/.gltf
    }

    // Generated certificate PDFs.
    match /certificates/{allPaths=**} {
      allow read:  if isSignedIn();
      allow write: if false; // generated by the server
    }

    // Default deny.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
