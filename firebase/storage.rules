rules_version = '2';

// JOHAR Storage rules. Training assets are readable by any signed-in user;
// only admins upload them. Certificate PDFs are written server-side.
service firebase.storage {
  match /b/{bucket}/o {
    match /modules/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }
    match /certificates/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if false; // generated by the server
    }
  }
}
