# ---- Blockchain (server-side only; never expose the signer key) ----
CERT_CONTRACT_ADDRESS=0xyour_deployed_contract_address
SIGNER_PRIVATE_KEY=0xserver_side_issuer_wallet_key
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# ---- Firebase Admin (service account) ----
FIREBASE_PROJECT_ID=johar-sih
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@johar-sih.iam.gserviceaccount.com
# Paste the private key with literal \n for newlines, wrapped in quotes.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---- Public (safe to expose) ----
NEXT_PUBLIC_APK_URL=https://github.com/your-org/johar/releases/latest
